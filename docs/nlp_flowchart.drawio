<mxfile host="app.diagrams.net"><diagram name="Compact Research Flowchart"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="📁 &lt;b&gt;PHASE 1 – Data Acquisition&lt;/b&gt;&lt;br&gt;&#10;📰 Financial News Collection&lt;br&gt;&#10;🧹 Cleaning &amp; Preprocessing&lt;br&gt;&#10;📊 Market Data Integration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="200" height="180" as="geometry" /></mxCell><mxCell id="3" value="🏷️ &lt;b&gt;PHASE 2 – Dataset Construction&lt;/b&gt;&lt;br&gt;&#10;🧠 Feature Engineering&lt;br&gt;&#10;⚙️ Label Creation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="120" width="200" height="180" as="geometry" /></mxCell><mxCell id="4" value="🤖 &lt;b&gt;PHASE 3 – Modeling&lt;/b&gt;&lt;br&gt;&#10;📌 Classical ML Models&lt;br&gt;&#10;🚀 Enhanced FinBERT + MLP Fusion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="120" width="200" height="180" as="geometry" /></mxCell><mxCell id="5" value="🔍 &lt;b&gt;PHASE 4 – Interpretability&lt;/b&gt;&lt;br&gt;&#10;• Attention Heatmaps&lt;br&gt;&#10;• LIME &amp; Counterfactuals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="120" width="200" height="180" as="geometry" /></mxCell><mxCell id="6" value="🛡️ &lt;b&gt;PHASE 5 – Robustness&lt;/b&gt;&lt;br&gt;&#10;• Noise Injection&lt;br&gt;&#10;• Adversarial Testing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="120" width=